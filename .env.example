NODE_ENV=development

# MongoDB Atlas connection string (database name /clyra)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/clyra?retryWrites=true&w=majority
# Any long random string. Use a different one in production.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated email domains allowed to register
ALLOWED_EMAIL_DOMAINS=lpu.in

# Optional email. Leave empty and messages are printed in the server console instead.
BREVO_API_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Clyra

# Used only by `npm run seed`. Never reuse in production.
SEED_PASSWORD=ChangeMe123!
