PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string (database name /clyra)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/clyra?retryWrites=true&w=majority
# Any long random string. Use a different one in production.
JWT_SECRET=replace-with-a-long-random-string

# Where the website runs (used for email links and CORS). No trailing slash.
CLIENT_URL=http://localhost:3000
# Comma-separated email domains allowed to register
ALLOWED_EMAIL_DOMAINS=lpu.in


# Email. Leave all empty in development: messages are printed in the server console.
# Production (works on Render's free tier): Brevo HTTP API
BREVO_API_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Clyra
# Local alternative: SMTP (blocked on Render's free tier)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Clyra <no-reply@clyra.local>"

# Used only by `npm run seed`. Never reuse in production.
SEED_PASSWORD=
